<view class="calculator {{theme}}"><view class="row"><text class="brand">CALCULATOR</text><button class="theme" bindtap="toggleTheme">{{theme==='light'?'切换深色':'切换浅色'}}</button></view><view class="display"><view class="expression">{{expression}}</view><view class="number">{{display}}</view></view><view class="keys"><button wx:for="{{keys}}" wx:key="*this" data-key="{{item}}" bindtap="key" class="key {{index%4===3?'operator':''}} {{item==='0'?'zero':''}} {{item==='='?'equal':''}} {{index>=3?'':'function'}}">{{item}}</button></view><view class="hint">最多 13 位数字 · 连续运算从左到右</view></view>
