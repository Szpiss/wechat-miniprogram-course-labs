<scroll-view class="player" scroll-y><view wx:if="{{track}}"><image class="cover" src="{{track.cover}}" mode="aspectFill"/><view class="song">{{track.name}}</view><view class="artist">{{track.artist}}</view><scroll-view class="lyrics" scroll-y scroll-into-view="{{lyricAnchor}}" scroll-with-animation><view wx:for="{{lines}}" wx:key="time" id="line-{{index}}" class="lyric {{lyricIndex===index?'current-line':''}}">{{item.text}}</view></scroll-view><slider min="0" max="{{duration}}" value="{{position}}" step="1" activeColor="#7699ff" backgroundColor="#34425f" block-size="16" bindchange="seek"/><view class="row times"><text>{{timeLabel}}</text><text>{{durationLabel}}</text></view><view class="controls"><button bindtap="previous">上一首</button><button class="play" bindtap="toggle">{{playing?'暂停':'播放'}}</button><button bindtap="next">下一首</button></view><view class="extras"><button bindtap="favorite">{{favorite?'已收藏':'收藏'}}</button><button bindtap="mode">{{mode}}播放</button></view></view></scroll-view>
