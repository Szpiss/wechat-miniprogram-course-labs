<scroll-view class="library" scroll-y><input class="search" placeholder="搜索原创旋律" value="{{keyword}}" bindinput="search"/><scroll-view class="playlists" scroll-x><view wx:for="{{playlists}}" wx:key="id" class="playlist {{playlist===item.id?'active':''}}" data-id="{{item.id}}" bindtap="playlist">{{item.name}}</view></scroll-view><view class="muted">{{loading?'加载中…':'原创演示音频 · '+visible.length+' 首'}}</view><view wx:for="{{visible}}" wx:key="id" class="track" data-index="{{index}}" bindtap="choose"><image src="{{item.cover}}" mode="aspectFill"/><view><view class="track-name">{{item.name}}</view><text class="muted">{{item.artist}}</text></view><text wx:if="{{track.id===item.id}}" class="playing-label">{{playing?'播放中':'已选择'}}</text></view><view wx:if="{{!visible.length && !loading}}" class="empty">没有找到歌曲</view></scroll-view>
