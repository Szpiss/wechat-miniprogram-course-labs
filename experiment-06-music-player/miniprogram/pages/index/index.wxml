<view class="music-app"><view class="row tabs"><view data-index="0" bindtap="tab" class="{{current===0?'selected':''}}">发现旋律</view><view data-index="1" bindtap="tab" class="{{current===1?'selected':''}}">正在播放</view></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><swiper current="{{current}}" bindchange="swipe" class="pages" duration="240"><swiper-item><include src="../../includes/library.wxml"/></swiper-item><swiper-item><include src="../../includes/player.wxml"/></swiper-item></swiper></view>
