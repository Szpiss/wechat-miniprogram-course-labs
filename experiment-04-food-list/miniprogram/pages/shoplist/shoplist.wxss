page {
  overflow: hidden;
}
.header {
  background: #ec7657;
  color: white;
  padding: 32rpx 28rpx;
}
.header text {
  font-size: 24rpx;
}
.search {
  background: #fff;
  color: #374151;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  margin-top: 24rpx;
  font-size: 24rpx;
}
.main {
  display: flex;
  height: calc(100vh - 280rpx);
}
.sidebar {
  width: 155rpx;
  background: #edf0f4;
  flex-shrink: 0;
}
.category {
  padding: 34rpx 10rpx;
  font-size: 24rpx;
  text-align: center;
  border-left: 6rpx solid transparent;
}
.active {
  background: white;
  color: #dc6547;
  border-color: #dc6547;
  font-weight: 600;
}
.list {
  flex: 1;
  width: 0;
  background: #fff;
  padding: 12rpx;
}
.food {
  display: flex;
  padding: 24rpx 10rpx;
  border-bottom: 1rpx solid #edf0f5;
}
.food image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.food-info {
  flex: 1;
}
.food-name {
  font-size: 28rpx;
  font-weight: 600;
}
.food .muted {
  font-size: 20rpx;
}
.price {
  color: #d7694d;
  font-weight: 600;
  margin-top: 12rpx;
}
.phone {
  font-size: 20rpx;
  color: #8693a5;
}
.load-more {
  font-size: 24rpx;
  background: #f3f5f8;
}
.timestamp {
  display: block;
  font-size: 18rpx;
  color: #939dab;
  text-align: center;
  padding: 20rpx;
}

.header{height:280rpx;}input.search{height:80rpx;line-height:36rpx;}
