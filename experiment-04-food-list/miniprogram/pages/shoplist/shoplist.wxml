<wxs src="../../utils/phone.wxs" module="phone"/><view class="header"><view class="title">紫金食堂</view><text>新鲜出炉 · 校园好味道</text><input class="search" model:value="{{keyword}}" bindinput="search" placeholder="筛选已加载的菜品"/></view><view class="main"><scroll-view class="sidebar" scroll-y><view wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="switchCategory" class="category {{category===item.id?'active':''}}">{{item.name}}</view></scroll-view><scroll-view class="list" scroll-y bindscrolltolower="more" lower-threshold="100" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="refresh"><view wx:for="{{filtered}}" wx:key="id" class="food"><image src="{{item.image}}" mode="aspectFill"/><view class="food-info"><view class="food-name">{{item.name}}</view><text class="muted">{{item.description}}</text><view class="price">¥ {{item.price}}</view><text class="phone" data-phone="{{item.phone}}" bindtap="call">{{phone.format(item.phone)}}</text></view></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry">重试</button></view><view class="empty">{{loading?'加载中…':hasMore?'上拉加载更多':'已加载全部菜品'}}</view><button wx:if="{{hasMore && !loading}}" class="load-more" bindtap="more">加载下一页</button><text class="timestamp" wx:if="{{refreshedAt}}">刷新：{{refreshedAt}}</text></scroll-view></view>
