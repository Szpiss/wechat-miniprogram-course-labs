page {
  background: #f4f6fa;
  color: #202b3b;
  font-family: -apple-system, sans-serif;
  font-size: 28rpx;
}
view {
  box-sizing: border-box;
}
button {
  font-size: 28rpx;
  border-radius: 20rpx;
}
button::after {
  border: none;
}
.container {
  padding: 28rpx;
}
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.title {
  font-size: 42rpx;
  font-weight: 700;
}
.muted {
  color: #778395;
  font-size: 24rpx;
  line-height: 1.8;
}
.primary {
  background: #2468ec;
  color: white;
  margin-top: 24rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.field {
  background: #f3f6fb;
  border-radius: 16rpx;
  padding: 22rpx;
  margin: 18rpx 0;
  min-height: 80rpx;
}
.error {
  color: #b63d47;
  padding: 20rpx;
  line-height: 1.8;
}
.pill {
  font-size: 22rpx;
  background: #e9effb;
  color: #2468ec;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}
.empty {
  text-align: center;
  color: #8893a4;
  padding: 60rpx;
}
.section {
  font-size: 32rpx;
  font-weight: 600;
  margin: 28rpx 0 18rpx;
}

input,textarea{box-sizing:border-box;}
