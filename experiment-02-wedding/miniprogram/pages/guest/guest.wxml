<view class="container"><view class="title">期待您的到来</view><view class="muted">请填写演示宾客信息</view><form bindsubmit="submit" class="card" style="margin-top:28rpx"><text class="label">姓名</text><input class="field" data-key="name" model:value="{{name}}" bindinput="input" maxlength="30" placeholder="姓名"/><text class="label">手机</text><input class="field" data-key="phone" model:value="{{phone}}" bindinput="input" type="number" maxlength="11" placeholder="11位手机号码"/><text class="label">出席人数</text><input class="field" data-key="count" model:value="{{count}}" bindinput="input" type="number" maxlength="2"/><text class="label">祝福</text><textarea class="field" data-key="message" model:value="{{message}}" bindinput="input" maxlength="200" placeholder="写下祝福"/><button class="primary" form-type="submit" loading="{{submitting}}" disabled="{{submitting}}">提交宾客信息</button><view class="muted">{{status}}</view></form></view>
