<view class="container"><view class="title">我们的相册</view><text class="muted">原创插画记录美好瞬间</text><view class="photo-wrap"><swiper vertical autoplay circular current="{{current}}" bindchange="change" interval="3500"><swiper-item wx:for="{{photos}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/></swiper-item></swiper><view class="dots"><view wx:for="{{photos}}" wx:key="*this" data-index="{{index}}" bindtap="select" class="dot {{current===index?'active':''}}"/></view></view><button class="music" bindtap="music">{{isPlayingMusic?'暂停背景音乐':'播放背景音乐'}}</button></view>
