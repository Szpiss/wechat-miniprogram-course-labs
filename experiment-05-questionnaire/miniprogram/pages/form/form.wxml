<view class="container"><view class="title">{{title}}</view><view class="muted">帮助我们了解你的学习体验</view><view wx:if="{{loading}}" class="empty">问卷加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><form wx:if="{{questions.length}}" bindsubmit="submit"><view class="card" style="margin-top:28rpx"><text class="section">姓名 *</text><input class="field" model:value="{{name}}" data-id="name" bindinput="input" maxlength="30" placeholder="请输入姓名"/></view><view wx:for="{{questions}}" wx:key="id" class="card"><view class="question">{{index+1}}. {{item.title}} {{item.required?'*':''}}</view><radio-group wx:if="{{item.type==='radio'}}" data-id="{{item.id}}" bindchange="radioChange"><label wx:for="{{item.options}}" wx:for-item="option" wx:key="*this" class="option"><radio value="{{option}}" checked="{{gender===option}}" color="#2468ec"/>{{option}}</label></radio-group><checkbox-group wx:if="{{item.type==='checkbox'}}" data-id="{{item.id}}" bindchange="checkboxChange"><label wx:for="{{item.options}}" wx:for-item="option" wx:key="*this" class="option"><checkbox checked="{{selectedSkills[option]}}" value="{{option}}"  color="#2468ec"/>{{option}}</label></checkbox-group><textarea wx:if="{{item.type==='textarea'}}" class="field" model:value="{{opinion}}" data-id="{{item.id}}" bindinput="input" maxlength="{{item.maxLength}}" placeholder="写下你的建议"/></view><button class="primary" form-type="submit" loading="{{submitting}}" disabled="{{submitting}}">提交问卷</button><view class="muted status">{{status}}</view></form></view>
