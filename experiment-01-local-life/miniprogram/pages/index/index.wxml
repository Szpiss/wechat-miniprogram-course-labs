<view class="container"><view class="profile"><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image class="avatar" src="{{avatar}}"/></button><view><input class="nickname" type="nickname" value="{{nickname}}" bindblur="nicknameChange" maxlength="20"/><text class="muted">欢迎来到你的城市生活</text></view><text class="city">南京</text></view>
<swiper class="banner" indicator-dots autoplay circular interval="4000"><swiper-item wx:for="{{banners}}" wx:key="src"><image src="{{item.src}}" mode="aspectFill"/><view class="banner-copy"><view>{{item.title}}</view><text>{{item.desc}}</text></view></swiper-item></swiper>
<view class="section">生活服务</view><view class="grid"><view class="service" wx:for="{{categories}}" wx:key="*this" data-name="{{item}}" bindtap="openService"><view class="service-icon icon-{{index%3}}">{{initials[index]}}</view><text>{{item}}</text></view></view>
<view class="card tip"><view class="title">今天，也要好好生活</view><text class="muted">点击服务入口，查看校园周边生活指南。</text></view></view>
